# Copy this file to .env and fill in real values.
# NEVER commit .env — it is blocked by .gitignore.

NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=<random-32-char-string>
JWT_REFRESH_SECRET=change-me-different-from-JWT_SECRET
JWT_EXPIRES_IN=7d

# Razorpay (use TEST keys locally — rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Razorpay Dashboard → Webhooks → secret (event: payment.captured, URL: /api/payment/webhook)
RAZORPAY_WEBHOOK_SECRET=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# VoyageAI
VOYAGE_API_KEY=...

# Cloudinary
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Shiprocket
SHIPROCKET_EMAIL=...
SHIPROCKET_PASSWORD=...

# CORS (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email via Brevo HTTPS API (free 300/day; works on Render free tier, which blocks SMTP).
# When BREVO_API_KEY is set it is used for ALL emails; the SMTP settings below are only a fallback.
# Brevo → Settings → SMTP & API → API Keys. The sender email must be verified in Brevo → Senders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=infinitycraftspacejsag@gmail.com
BREVO_SENDER_NAME=Infinity Craft Space

# Blog agent (writes a "Behind the Craft" post every few days — settings live in Admin → Blog).
# Uses ANTHROPIC_API_KEY. Model defaults to claude-opus-5-5; set a cheaper one here if you prefer.
BLOG_AGENT_MODEL=
# Optional: lets an external pinger (UptimeRobot / cron-job.org) trigger the schedule check and keep a free
# Render instance awake. Ping GET https://<your-backend>/api/blog-agent/tick with header x-cron-secret: <this value>
BLOG_AGENT_TICK_SECRET=
# SEO agent: model for suggestions/answers (defaults to claude-opus-5-5), and an optional free Google PageSpeed key
# for real phone-speed tests (Google Cloud -> APIs -> "PageSpeed Insights API" -> create an API key).
MARKETING_AGENT_MODEL=
SEO_AGENT_MODEL=
PAGESPEED_API_KEY=
# The address customers use (no trailing slash, no www) - must match the canonical tags. Used by the sitemap and the SEO audit.
SITE_URL=https://infinitycraftspace.com

# WhatsApp notifications are off unless this is "true"
WHATSAPP_ENABLED=false

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
# Email delivery (Gmail: turn on 2-step verification, then create an App Password)
EMAIL_USER=your-address@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=...

# Bill of Supply (shop is not GST-registered) — optional extras printed on the PDF
SHOP_PAN=CMXPG8307F
SHOP_PHONE=
SHOP_EMAIL=infinitycraftspacejsag@gmail.com
